              "Model",
              "Part",
              "WedgePart",
              "MeshPart",
              "SpecialMesh",
              "Attachment",
              "ParticleEmitter",
              "Beam",
              "Trail",
              "PointLight",
              "SpotLight",
              "SurfaceLight",
              "Sound"
            ]
          },
          "parentId": {
            "type": "string",
