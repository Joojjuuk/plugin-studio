              "pattern": "^[A-Za-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "properties"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "emit",
              "effect",
              "event"
            ]
          },
          "properties": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "emit": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "easingStyle": {
            "type": "string"
          },
          "easingDirection": {
            "type": "string",
            "enum": [
              "In",
              "Out",
              "InOut"
            ]
          },
          "easingCurve": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "required": [
          "objectId",
          "frame",
          "kind",
          "properties"
        ],
        "additionalProperties": false
      }
